{
  "port": 8080,
  "dir": "./",
  "redirect": "/sub_page",
  "fallbackRedirect": "/sub_page",
  "staticProxy": {
    "/sub_page": {
      "target": "./dist",
      "type": "static"
    },
    "/app": {
      "target": "http://localhost:3000",
      "type": "http",
      "changeOrigin": true
    }
  },
  "log": true
}
